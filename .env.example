# Copied to .env by `make up` on first run. The server has its own values (P7).
BASE_URL=https://ourcalendar.localhost:8444
# Optional: who runs this instance, named on the privacy page.
OPERATOR_NAME=
# The server for `make deploy` and the server-*/backup-* targets, e.g. deploy@203.0.113.10
# (`make server-create` prints it; docs/runbooks/server.md). Its settings live on the server.
DEPLOY_HOST=
