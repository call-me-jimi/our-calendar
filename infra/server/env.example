# The server's /srv/wannpassts/.env (P7, docs/runbooks/server.md): settings, never secrets.
# Those are files in /srv/wannpassts/secrets/ (root only). `make server-init` copies this
# file there once, with DOMAIN filled in from the server's IPv4. Compose interpolates it:
# write a `$` in a value as `$$`.

# The app's address. sslip.io resolves the name to the IP it spells, so Caddy gets a real
# certificate without DNS of our own. A real domain later: point its A record at the
# server, change DOMAIN, `make deploy` (sessions and feed URLs move to the new name).
DOMAIN=0-0-0-0.sslip.io
BASE_URL=https://${DOMAIN}

# Optional: a name the app used to have (e.g. wann.0-0-0-0.sslip.io). Caddy keeps its
# certificate and sends every request there to the same path on DOMAIN (301).
OLD_DOMAIN=

# Optional: who runs this instance, named on the privacy page. Empty: no name shown.
OPERATOR_NAME=

# Optional: Let's Encrypt's contact address. Empty: no email on the ACME account.
ACME_EMAIL=

# The backups' Storage Box sub-account, user@host (docs/runbooks/backup.md), e.g.
# u123456-sub1@u123456-sub1.your-storagebox.de. Written by `make backup-init`.
STORAGE_BOX=

# Optional: a healthchecks.io ping URL for the nightly backup. Empty: no pings.
HEALTHCHECKS_URL=
